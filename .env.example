# Copy to `.env` for local runs (never commit `.env`).
# CI should inject the same variable names from its secrets store.

# --- Postgres example (URL form) ---
# SOURCE_URL=postgresql+psycopg://migrator:secret@db.internal:5432/legacy
# TARGET_URL=postgresql+psycopg://migrator:secret@warehouse.internal:5432/core

# --- Postgres example (structured suite fields) ---
SOURCE_HOST=db.internal
SOURCE_PORT=5432
SOURCE_DB=legacy
SOURCE_USER=migrator
SOURCE_PASSWORD=replace-me

TARGET_HOST=warehouse.internal
TARGET_PORT=5432
TARGET_DB=core
TARGET_USER=migrator
TARGET_PASSWORD=replace-me

# --- Athena / AWS example ---
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ATHENA_SCHEMA=migrated
# ATHENA_S3_STAGING=s3://my-athena-results/staging/
# ATHENA_WORKGROUP=primary
