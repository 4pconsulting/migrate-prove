# Copy to `.env` for local runs (never commit `.env`).
# CI should inject the same variable names from its secrets store.
# Suite YAML shapes for each kind: README.md "Connections and secrets" + ADVANCED.md.

# --- Postgres example (URL form) ---
# SOURCE_URL=postgresql+psycopg://migrator:secret@db.internal:5432/legacy
# TARGET_URL=postgresql+psycopg://migrator:secret@warehouse.internal:5432/core

# --- Postgres example (structured suite fields) ---
SOURCE_HOST=db.internal
SOURCE_PORT=5432
SOURCE_DB=legacy
SOURCE_USER=migrator
SOURCE_PASSWORD=replace-me

TARGET_HOST=warehouse.internal
TARGET_PORT=5432
TARGET_DB=core
TARGET_USER=migrator
TARGET_PASSWORD=replace-me

# --- Athena / AWS example ---
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ATHENA_SCHEMA=migrated
# ATHENA_S3_STAGING=s3://my-athena-results/staging/
# ATHENA_WORKGROUP=primary

# --- Live Salesforce (kind: salesforce) ---
# Requires: pip install 'migrate-prove[salesforce]'
# Token: POST {SALESFORCE_URL}/services/oauth2/token (client_credentials)
# Then Bearer auth against the token response instance_url.
#
# suite.yaml target:
#   kind: salesforce
#   url: ${SALESFORCE_URL}
#   api_version: ${SALESFORCE_API_VERSION}
#   client_id: ${SALESFORCE_CLIENT_ID}
#   client_secret: ${SALESFORCE_CLIENT_SECRET}
#
# SALESFORCE_URL=https://your-domain.my.salesforce.com
# SALESFORCE_API_VERSION=59.0
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# --- Declarative HTTP API (kind: http) ---
# Requires: pip install 'migrate-prove[http]'
#
# suite.yaml target:
#   kind: http
#   base_url: ${API_BASE_URL}
#   auth:
#     type: bearer                 # bearer | header | basic
#     token: ${API_TOKEN}
#     # header_name: X-Api-Key
#     # header_value: ${API_KEY}
#     # username: ${API_USER}
#     # password: ${API_PASSWORD}
#   resources:
#     Account:
#       list_path: /v1/accounts
#       schema_path: /v1/accounts/schema   # optional
#       records_jmespath: data
#       next_jmespath: next
#
# API_BASE_URL=https://api.example.com
# API_TOKEN=
# API_KEY=
# API_USER=
# API_PASSWORD=
