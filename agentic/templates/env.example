# Copy to .env and fill. Never commit real values.
# Demo SQLite suites often need no secrets (urls embedded in suite.yaml).

# SOURCE_URL=postgresql+psycopg://user:pass@host:5432/db
# TARGET_URL=postgresql+psycopg://user:pass@host:5432/db

# SOURCE_HOST=
# SOURCE_DB=
# SOURCE_USER=
# SOURCE_PASSWORD=

# TARGET_HOST=
# TARGET_DB=
# TARGET_USER=
# TARGET_PASSWORD=

# Athena / other dialects: put full SQLAlchemy URL in SOURCE_URL / TARGET_URL
# AWS credentials typically come from the environment / profile, not this file.

# --- Live Salesforce (kind: salesforce) ---
# pip install 'migrate-prove[salesforce]'
# suite.yaml: kind: salesforce + url / api_version / client_id / client_secret
# SALESFORCE_URL=https://your-domain.my.salesforce.com
# SALESFORCE_API_VERSION=59.0
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# --- Declarative HTTP API (kind: http) ---
# pip install 'migrate-prove[http]'
# suite.yaml: kind: http + base_url + auth + resources
# API_BASE_URL=https://api.example.com
# API_TOKEN=
# API_KEY=
# API_USER=
# API_PASSWORD=
